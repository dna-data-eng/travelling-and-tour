# Copy this file to .env.local and fill in the real business details.
# .env.local is already git-ignored, so real numbers/addresses never get
# committed. Every value is optional — anything left blank falls back to
# a clearly-marked placeholder in lib/site-config.ts.

NEXT_PUBLIC_SITE_NAME="Akwantufuo Travel Consult"
NEXT_PUBLIC_SITE_URL="https://www.akwantufuo.com"

NEXT_PUBLIC_PHONE_PRIMARY="+233 XX XXX XXXX"
NEXT_PUBLIC_PHONE_SECONDARY="+233 XX XXX XXXX"
NEXT_PUBLIC_WHATSAPP_NUMBER="233XXXXXXXXX"
NEXT_PUBLIC_EMAIL="info@akwantufuo.com"

NEXT_PUBLIC_ADDRESS_LINE1="Opposite MTN Office"
NEXT_PUBLIC_ADDRESS_LINE2="Agona Swedru, Central Region, Ghana"
NEXT_PUBLIC_DIGITAL_GPS="CE-XXX-XXXX"

NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/akwantufuo"
NEXT_PUBLIC_TIKTOK_URL="https://tiktok.com/@akwantufuo"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/company/akwantufuo"

# Google Maps "Embed a map" iframe src, e.g. https://www.google.com/maps/embed?pb=...
NEXT_PUBLIC_MAP_EMBED_URL=""

# Optional form-relay endpoint (e.g. a Formspree URL) for the contact form.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=""
